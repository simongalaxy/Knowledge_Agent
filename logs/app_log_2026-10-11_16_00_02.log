               'filetype': 'application/pdf',
               'languages': ['eng'],
               'last_modified': '2026-10-10T22:35:06',
               'orig_elements': '',
               'page_number': 1},
  'text': 'Guidelines is for reference of restaurant operators in devising '
          'their house rules and\n'
          '\n'
          'operational arrangements.',
  'type': 'CompositeElement'},
 {'element_id': '55d33082-d6a4-47d4-aa9c-a0c37318298b',
  'metadata': {'file_directory': './KnowledgeFiles',
               'filename': 'Guidelines on Good Practices and Behaviour for '
