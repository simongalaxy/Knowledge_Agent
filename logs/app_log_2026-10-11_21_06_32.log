 '                        "start_col_offset_idx": 0,\n'
 '                        "end_col_offset_idx": 1,\n'
 '                        "text": "Step 2",\n'
 '                        "column_header": false,\n'
 '                        "row_header": false,\n'
 '                        "row_section": false,\n'
 '                        "fillable": false\n'
 '                    },\n'
 '                    {\n'
 '                        "bbox": {\n'
